#ifndef __SLANG__
#extension GL_EXT_mesh_shader : enable
#endif
#include "Slang/slangMesh.glsl"

#ifndef __SLANG__
layout (local_size_x = 1, local_size_y = 1, local_size_z = 1) in;
layout (triangles, max_vertices = 3, max_primitives = 1) out;
#endif

#ifdef __SLANG__
// See Slang/slangMesh.glsl
struct PerVertexData {
  float4 gl_Position : SV_Position;
  [[vk::location(0)]] vec4 color;
};
#define v_out slang_mesh_vertices_
#else
layout (location = 0) out PerVertexData {
  vec4 color;
} v_out[];
#endif

float scale = 0.95;
const vec2 vertices[3] = {vec2(-1,1), vec2(0,-1), vec2(1,1)};
const vec3 colors[3] = {vec3(1,0,0), vec3(0,1,0), vec3(0,0,1)};

#ifdef __SLANG__
[outputtopology("triangle")]
[numthreads(1, 1, 1)]
void main(SLANG_MESH_OUTPUTS(PerVertexData, 3, uint3, 1))
#else
void main()
#endif
{
  // size output for 3 vertices and 1 primitive (triangle)
  SetMeshOutputsEXT(3, 1);

  // vertex positions
  gl_MeshVerticesEXT[0].gl_Position = vec4(vertices[0] * scale, 0.0, 1.0);
  gl_MeshVerticesEXT[1].gl_Position = vec4(vertices[1] * scale, 0.0, 1.0);
  gl_MeshVerticesEXT[2].gl_Position = vec4(vertices[2] * scale, 0.0, 1.0);

  // vertex colors
  v_out[0].color = vec4(colors[0], 1.0);
  v_out[1].color = vec4(colors[1], 1.0);
  v_out[2].color = vec4(colors[2], 1.0);

  // triangle indices
  gl_PrimitiveTriangleIndicesEXT[0] = uvec3(0, 1, 2);
}
