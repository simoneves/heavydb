#ifndef __SLANG__
#extension GL_EXT_mesh_shader : enable
#endif
#include "Slang/slangMesh.glsl"

#include "DriverTests/testUtils.glsl"

#define MAX_NUM_MESH_TASKS <maxNumMeshTasks>
#define MAX_NUM_QUADS <maxNumQuads>

#ifndef __SLANG__
layout (local_size_x = MAX_NUM_MESH_TASKS, local_size_y = 1, local_size_z = 1) in;
layout (triangles, max_vertices = MAX_NUM_QUADS * 4, max_primitives = MAX_NUM_QUADS * 2) out;
#endif

struct TaskData
{
  uvec2 pixel_coord;
  uint num_quads;
};
#ifndef __SLANG__
taskPayloadSharedEXT TaskData td;
#endif

#ifdef __SLANG__
// See Slang/slangMesh.glsl
struct PerVertexData {
  float4 gl_Position : SV_Position;
  [[vk::location(0)]] vec4 color;
};
#define v_out slang_mesh_vertices_
#else
layout (location = 0) out PerVertexData {
  vec4 color;
} v_out[];
#endif

layout(std430) uniform MESH_SHADER_UBO_TYPE {
  uvec2 imageSizeM;
};

#ifdef __SLANG__
[outputtopology("triangle")]
[numthreads(MAX_NUM_MESH_TASKS, 1, 1)]
void main(in payload TaskData td,
          SLANG_MESH_OUTPUTS(PerVertexData, MAX_NUM_QUADS * 4, uint3, MAX_NUM_QUADS * 2))
#else
void main()
#endif
{
  float x_scale = 2.0 / float(imageSizeM.x);
  float y_scale = 1.0 / float(imageSizeM.y);
  float y_offset = float(td.pixel_coord.y) * (y_scale * 2.0) - (1.0 - y_scale);

  vec2 pos[4] = {vec2(-x_scale, -y_scale + y_offset),
                 vec2( x_scale, -y_scale + y_offset),
                 vec2( x_scale,  y_scale + y_offset),
                 vec2(-x_scale,  y_scale + y_offset)};

  // size output
  SetMeshOutputsEXT(MAX_NUM_QUADS * 4, MAX_NUM_QUADS * 2);

  int vertex_id = 0;
  int index_id = 0;
  float x_offset = -1.0 + (float(td.pixel_coord.x + (gl_WorkGroupID.x * td.num_quads)) * x_scale);

  for (int quad = 0; quad < td.num_quads; quad++, vertex_id += 4, index_id += 2, x_offset += x_scale) {
    gl_MeshVerticesEXT[vertex_id  ].gl_Position = vec4(pos[0].x + x_offset, pos[0].y, 0.0, 1.0);
    gl_MeshVerticesEXT[vertex_id+1].gl_Position = vec4(pos[1].x + x_offset, pos[1].y, 0.0, 1.0);
    gl_MeshVerticesEXT[vertex_id+2].gl_Position = vec4(pos[2].x + x_offset, pos[2].y, 0.0, 1.0);
    gl_MeshVerticesEXT[vertex_id+3].gl_Position = vec4(pos[3].x + x_offset, pos[3].y, 0.0, 1.0);

    float hue = y_offset * 180.0;
    float light = float(quad + td.pixel_coord.x + gl_WorkGroupID.x * td.num_quads) / float(imageSizeM.x) * 0.85 + 0.05;

    vec4 c = transformHSLtoRGB(vec4(hue, 1.0, light, 1.0));
    v_out[vertex_id    ].color = c;
    v_out[vertex_id + 1].color = c;
    v_out[vertex_id + 2].color = c;
    v_out[vertex_id + 3].color = c;

    gl_PrimitiveTriangleIndicesEXT[index_id    ] = uvec3(vertex_id, vertex_id + 1, vertex_id + 2);
    gl_PrimitiveTriangleIndicesEXT[index_id + 1] = uvec3(vertex_id, vertex_id + 2, vertex_id + 3);
  }
}
